# =============================================================================
# ProxyLead environment template
# -----------------------------------------------------------------------------
# Copy to `.env` at the repository root for local development and fill in
# values. `.env` is git-ignored. NEVER commit real credentials.
#
# The API (apps/api) and the MCP tool server (services/toolserver) read this
# root `.env` (real environment variables take precedence). The web app
# (apps/web) reads only `VITE_*` variables (see apps/web/.env.example).
#
# Nothing here is required just to import the apps or run the unit tests:
# health endpoints and tests work with every secret left empty.
# Names follow ProxyLead_PRD_v2.md §12 and ProxyLead_Architecture_v2.1.md §17.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the backend API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Signs the web demo session cookie (Phase: web sign-in). Long random string.
SESSION_SECRET=
# Signs the per-call identity envelope `_ctx` that the backend passes to the
# MCP tool server (PRD v2 §9). Shared by backend and MCP server only.
CTX_SECRET=
# Demo sign-in passcode for the public web playground (PRD v2 §4.1).
DEMO_PASSCODE=
# Server-side secret for demo reset / admin operations.
ADMIN_TOKEN=

# --- Neon PostgreSQL + pgvector (ADR-002) ------------------------------------
# Three separate roles (PRD v2 §8.1). Use Neon connection strings with
# sslmode=require. The backend role must NOT be able to read protected
# knowledge tables; only the MCP tool server role can.
DATABASE_URL_BACKEND=
DATABASE_URL_TOOLSERVER=
# Migration/seed role. Used by migration scripts only, never by a running app.
DATABASE_URL_MIGRATE=

# --- Local Docker Compose (P1-11, docs/DOCKER.md) ---------------------------
# Uncomment and adapt when running `docker compose up`. All values below are
# local-only placeholders, never secrets. Production uses Neon role DSNs
# (P2-01). Compose defaults only DATABASE_URL_MIGRATE to the local `db`
# owner account. DATABASE_URL_BACKEND / DATABASE_URL_TOOLSERVER must point at
# the local LOGIN users created after `docker compose run --rm migrate`
# (docs/DOCKER.md §6). Never set them to the owner account below: that would
# hide the backend/toolserver grant boundary.
# POSTGRES_USER=proxylead
# POSTGRES_PASSWORD=proxylead-local-only
# POSTGRES_DB=proxylead
# DATABASE_URL_MIGRATE=postgresql://proxylead:proxylead-local-only@db:5432/proxylead
# DATABASE_URL_BACKEND=postgresql://proxylead_backend_login:backend-local-only@db:5432/proxylead
# DATABASE_URL_TOOLSERVER=postgresql://proxylead_toolserver_login:toolserver-local-only@db:5432/proxylead

# --- ArmorIQ (authorization) --------------------------------------------------
# Service API key from the ArmorIQ console (ak_live_... / ak_test_...).
ARMORIQ_API_KEY=
# Registered agent name; must match the ArmorIQ console exactly.
ARMORIQ_AGENT_ID=proxylead
# Console URL shown to Maya in HOLD notifications.
ARMORIQ_CONSOLE_URL=https://platform.armoriq.ai
# Registered MCP endpoint names; must match the console registry exactly.
ARMORIQ_MCP_MEMORY_NAME=memory-mcp
ARMORIQ_MCP_WORKSPACE_NAME=workspace-mcp
# Intent-token lifetime and approval wait. Startup asserts
# TOKEN_VALIDITY_S*1000 > APPROVAL_TIMEOUT_MS + 120000 (PRD v2 §7.1).
TOKEN_VALIDITY_S=1200
APPROVAL_TIMEOUT_MS=900000
# Only set if experiment E1 proves the SDK-supplied MCP credential path is
# required (JSON, see armoriq-sdk docs). Leave unset otherwise.
# ARMORIQ_MCP_CREDENTIALS=

# --- Demo members: trusted identity mapping (PRD v2 §4.1) -------------------
# Real, invited ArmorIQ organization member emails. Masked in UI and logs.
PERSONA_MAYA_EMAIL=
PERSONA_SAM_EMAIL=
PERSONA_PRIYA_EMAIL=
# Slack user IDs (Uxxxxxxx) mapped to the same members.
SLACK_USER_MAYA_ID=
SLACK_USER_SAM_ID=
SLACK_USER_PRIYA_ID=

# --- Slack (Bolt for Python, Socket Mode, one workspace) ---------------------
# Bot token (xoxb-...).
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with connections:write, required by Socket Mode.
SLACK_APP_TOKEN=
# Workspace/team ID the bot is allowed to serve.
SLACK_TEAM_ID=
# Comma-separated channel IDs the bot may respond in.
SLACK_ALLOWED_CHANNELS=
# Not needed for Socket Mode. Only required if the HTTP Events API is ever
# used instead (out of MVP scope).
# SLACK_SIGNING_SECRET=

# --- Anthropic Claude (planner / responder) ----------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Knowledge retrieval (MCP tool server only) ------------------------------
# Local FastEmbed model, 384 dimensions (PRD v2 §8.2).
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Must be calibrated by experiment E17 — do not guess. Leave empty until then.
MIN_SCORE=

# --- MCP tool server ---------------------------------------------------------
# Public HTTPS base URL once deployed (e.g. https://proxylead-mcp.example.com).
TOOLSERVER_BASE_URL=
# Bearer credentials required on /memory/mcp and /workspace/mcp. If unset,
# the MCP server rejects every MCP request (fail closed).
TOOLSERVER_BEARER_MEMORY=
TOOLSERVER_BEARER_WORKSPACE=
# Comma-separated Host header values the MCP server accepts (DNS-rebinding
# protection). Use your public hostname when deployed. Local compose ignores
# this value and always uses `toolserver:8100,localhost:8100,127.0.0.1:8100`.
MCP_ALLOWED_HOSTS=localhost:8100,127.0.0.1:8100
# Expose the scaffold-only diagnostic ping tools (no data access).
MCP_ENABLE_DIAGNOSTIC_TOOLS=true
