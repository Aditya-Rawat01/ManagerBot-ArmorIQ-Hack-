# =============================================================================
# ProxyLead API (apps/api) environment template
# -----------------------------------------------------------------------------
# Copy to `apps/api/.env` for API-only local settings. `.env` is git-ignored and
# excluded from every Docker image. NEVER commit real credentials.
#
# Load order (apps/api/core/config.py): real environment variables win, then
# `apps/api/.env`, then the repository-root `.env`. You can keep everything in
# the root `.env` (see the root `.env.example`) instead of this file.
#
# Only the variables the API reads are listed here. The API must NEVER be
# given DATABASE_URL_TOOLSERVER, DATABASE_URL_MIGRATE or the TOOLSERVER_BEARER_*
# credentials (least privilege, PRD v2 §8.1).
#
# Nothing here is required to start the app or run the tests: with every secret
# empty, /health works and the features that need a secret fail closed.
# Names follow ProxyLead_PRD_v2.md §12 and ProxyLead_Architecture_v2.1.md §17.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API (`*` is rejected).
# Deployed: the Vercel production origin (ADR-030) plus local origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Signs the web demo session cookie (ADR-031). Long random string.
SESSION_SECRET=
# Signs the per-call `_ctx` envelope sent to the MCP tool server. Must be the
# SAME value as the tool server's CTX_SECRET.
CTX_SECRET=
# Demo sign-in passcode for the web playground (PRD v2 §4.1).
DEMO_PASSCODE=
# Server-side secret for demo reset / admin operations.
ADMIN_TOKEN=

# --- Database (Neon PostgreSQL; backend role = app metadata only) ------------
# The backend role must NOT be able to read protected knowledge tables.
# Local Docker Compose: leave empty until P2-01 creates the backend role.
DATABASE_URL_BACKEND=

# --- ArmorIQ (only services/authorization/armoriq_gateway.py uses these) ------
# Service API key from the ArmorIQ console (ak_live_... / ak_test_...).
ARMORIQ_API_KEY=
# Registered agent name; must match the ArmorIQ console exactly.
ARMORIQ_AGENT_ID=proxylead
# Console URL shown to Maya in HOLD notifications.
ARMORIQ_CONSOLE_URL=https://platform.armoriq.ai
# Registered MCP endpoint names; must match the console registry exactly.
ARMORIQ_MCP_MEMORY_NAME=memory-mcp
ARMORIQ_MCP_WORKSPACE_NAME=workspace-mcp
# Intent-token lifetime and approval wait. Startup asserts
# TOKEN_VALIDITY_S*1000 > APPROVAL_TIMEOUT_MS + 120000 (PRD v2 §7.1).
TOKEN_VALIDITY_S=1200
APPROVAL_TIMEOUT_MS=900000
# armoriq-sdk telemetry: when on, the SDK uploads trace spans (plan goal text,
# which includes search-query fragments) to ArmorIQ's /observability/spans.
# The SDK turns it on by default; the gateway keeps it off unless this is
# `true` (docs/SECURITY.md "ArmorIQ SDK telemetry").
ARMORIQ_OBSERVABILITY=false

# --- Demo members: trusted identity mapping (PRD v2 §4.1, P1-03) ------------
# Real, invited ArmorIQ member emails (Maya = Aditya-Rawat01,
# Sam = samarth-chawla, Priya = parthgoyal26-03-2005). Masked in UI and logs.
# A persona without an email cannot sign in.
PERSONA_MAYA_EMAIL=
PERSONA_SAM_EMAIL=
PERSONA_PRIYA_EMAIL=
# Slack user IDs (Uxxxxxxx) mapped to the same members.
SLACK_USER_MAYA_ID=
SLACK_USER_SAM_ID=
SLACK_USER_PRIYA_ID=

# --- Slack (Bolt for Python, Socket Mode, one workspace) ---------------------
# Bot token (xoxb-...).
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with connections:write, required by Socket Mode.
SLACK_APP_TOKEN=
# Workspace/team ID the bot is allowed to serve.
SLACK_TEAM_ID=
# Comma-separated channel IDs the bot may respond in.
SLACK_ALLOWED_CHANNELS=

# --- Anthropic Claude (planner / responder) ----------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Grounding threshold (responder; calibrated by E17 / P3-08) --------------
# PRD §12 MIN_SCORE. Leave unset (or empty) until experiment E17 calibrates it:
# the responder then abstains with reason `threshold_unset` and never guesses
# (D-23). If a search result also carries a `min_score`, the stricter (higher)
# value applies.
# MIN_SCORE=

# --- MCP tool server ---------------------------------------------------------
# Public HTTPS base URL of the deployed tool server (P1-05, Render), e.g.
# https://<service>.onrender.com. Not read by API code yet; tool calls always
# go through ArmorIQ, never directly from the API to the tool server.
TOOLSERVER_BASE_URL=
